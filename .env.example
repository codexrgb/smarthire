# SmartHire 2.0 — Environment Configuration Template
# Copy this file to .env and replace placeholders with your actual values.
# NEVER commit the real .env file or production secrets to source control.

# ==============================================================================
# Security & JWT Authentication
# ==============================================================================
# Generate a strong 32-byte secret key using: openssl rand -hex 32
SECRET_KEY=your-super-secret-jwt-signing-key-placeholder-min-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ==============================================================================
# Database Persistence (PostgreSQL / SQLite)
# ==============================================================================
# PostgreSQL production/staging connection string:
# Format: postgresql://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql://postgres:postgres_password@localhost:5432/smarthire_db

# Local SQLite fallback for isolated unit testing & offline development:
# DATABASE_URL=sqlite:///./smarthire_dev.db

# ==============================================================================
# Cross-Origin Resource Sharing (CORS)
# ==============================================================================
# Comma-separated list of allowed origins (e.g. Vite frontend, Streamlit, local dev)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8501,http://127.0.0.1:3000,http://127.0.0.1:5173,http://127.0.0.1:8501

# ==============================================================================
# Private File Storage
# ==============================================================================
# Path where encrypted/hashed resume binaries are safely stored
STORAGE_DIR=./storage/resumes
# Maximum upload file size in Megabytes (default: 10MB)
MAX_UPLOAD_SIZE_MB=10
